# Cruise Assistant Environment Configuration
# Copy this file to .env and fill in your actual values

# API Keys (Required)
QLOO_API_KEY=REPLACE_WITH_YOUR_QLOO_API_KEY
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY

# RAG System Configuration
EMBEDDING_MODEL=text-embedding-3-large
PINECONE_API_KEY=REPLACE_WITH_YOUR_PINECONE_API_KEY
PINECONE_INDEX_NAME=cruise-events

# Phase 2: Advanced Features
USE_RERANKING=true
RERANKING_TYPE=hybrid
RERANKING_MODEL=gpt-4

# Environment Settings
NODE_ENV=production
LOG_LEVEL=info

# Server Configuration
PORT=3001

# Optional: Database (if needed in future)
# DATABASE_URL=postgresql://user:password@localhost:5432/cruise_assistant

# Optional: Redis (if needed for caching)
# REDIS_URL=redis://localhost:6379

# Optional: Monitoring
# SENTRY_DSN=your_sentry_dsn_here
# NEW_RELIC_LICENSE_KEY=your_new_relic_key_here 